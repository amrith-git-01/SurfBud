# Extension — Chrome Manifest V3 Rules

## Architecture — Separation of Concerns

```
service-worker/   → background.ts — event listeners, message routing, chrome.alarms
                    No DOM access. No window object. Persists nothing in variables.

side-panel/       → React app rendered in chrome.sidePanel
                    Primary UI surface. Full React + Tailwind.

popup/            → React app rendered in extension action popup
                    Minimal UI — mode switcher, quick stats only.

content/          → content.ts — injected into pages, minimal DOM interaction
                    Only reads tab metadata. Never modifies page content.

utils/            → shared pure functions, message type constants
```

## Service Worker — Critical Rules

```typescript
// ✅ ALL event listeners must be registered at the TOP LEVEL — never inside callbacks
// The service worker can be restarted at any time — async registration is missed

// ✅ CORRECT — top level registration
chrome.runtime.onMessage.addListener(handleMessage)
chrome.downloads.onCreated.addListener(handleDownload)
chrome.tabs.onActivated.addListener(handleTabActivated)
chrome.alarms.onAlarm.addListener(handleAlarm)

// ❌ WRONG — listener inside async callback, will be missed on service worker restart
chrome.storage.local.get('settings', (settings) => {
  chrome.downloads.onCreated.addListener(handleDownload)  // NOT GUARANTEED
})

// ✅ Service worker has no persistent memory — always read state from chrome.storage
// ❌ Never rely on module-level variables surviving between events
let activeMode = 'dev'               // LOST when service worker sleeps
chrome.storage.local.get('activeMode', ({ activeMode }) => { }) // ✅ CORRECT

// ✅ Use chrome.alarms to keep service worker responsive for periodic tasks
chrome.alarms.create('sync-metrics', { periodInMinutes: 5 })

// ✅ For async message responses — return true from listener to keep channel open
chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
  if (message.type === 'GET_METRICS') {
    handleGetMetrics(message, sendResponse)
    return true   // ← REQUIRED for async responses
  }
})
```

## Message Passing — Typed Messages

```typescript
// ✅ All message types defined as discriminated union in shared/messages.ts
// Copy this file into extension/src/types/shared/

export type ExtensionMessage =
  | { type: 'START_MODE';    payload: { modeId: string } }
  | { type: 'STOP_MODE';     payload: { modeId: string } }
  | { type: 'GET_METRICS';   payload: { period: string } }
  | { type: 'DOWNLOAD_NEW';  payload: Download }
  | { type: 'TAB_CHANGED';   payload: { tabId: number; url: string; title: string } }

// ✅ Typed send helper — never raw chrome.runtime.sendMessage with unknown payload
export async function sendMessage<T extends ExtensionMessage>(
  message: T
): Promise<unknown> {
  return chrome.runtime.sendMessage(message)
}

// ✅ Type-safe message handler
chrome.runtime.onMessage.addListener((message: ExtensionMessage, sender, sendResponse) => {
  switch (message.type) {
    case 'START_MODE':
      handleStartMode(message.payload, sendResponse)
      return true
    case 'GET_METRICS':
      handleGetMetrics(message.payload, sendResponse)
      return true
  }
})
```

## Permissions — Principle of Least Privilege

```json
// ✅ manifest.json — only request permissions actually used
{
  "manifest_version": 3,
  "permissions": [
    "downloads",
    "tabs",
    "storage",
    "sidePanel",
    "alarms",
    "identity"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}

// ❌ Never request permissions speculatively
// "webRequest", "history", "bookmarks" — only add if actually used
// "host_permissions": ["<all_urls>"] — never unless absolutely required
```

## chrome.storage — Always Typed

```typescript
// ✅ Typed storage helper — never raw chrome.storage with unknown shape
interface ExtensionStorage {
  activeMode:    string | null
  userId:        string | null
  accessToken:   string | null
  sessionStart:  number | null
  settings:      UserSettings
}

export async function getStorage<K extends keyof ExtensionStorage>(
  key: K
): Promise<ExtensionStorage[K]> {
  return new Promise((resolve) => {
    chrome.storage.local.get(key, (result) => resolve(result[key]))
  })
}

export async function setStorage<K extends keyof ExtensionStorage>(
  key: K,
  value: ExtensionStorage[K]
): Promise<void> {
  return new Promise((resolve) => {
    chrome.storage.local.set({ [key]: value }, resolve)
  })
}

// ✅ Use chrome.storage.local for session data, chrome.storage.sync for settings
// chrome.storage.local — faster, larger (10MB), not synced across devices
// chrome.storage.sync  — smaller (100KB), synced, for user preferences only
```

## Downloads API

```typescript
// ✅ Always listen at top level
chrome.downloads.onCreated.addListener(async (downloadItem) => {
  // Debounce rapid fire events
  const existing = await getStorage('recentDownloads') ?? []
  if (existing.find(d => d.id === downloadItem.id)) return

  // Send to API via queue — never direct fetch in service worker listener
  await queueDownloadEvent({
    id:       downloadItem.id,
    filename: downloadItem.filename,
    url:      downloadItem.url,
    fileSize: downloadItem.fileSize,
    mime:     downloadItem.mime,
    startTime: downloadItem.startTime,
  })
})

// ✅ Use chrome.downloads.search for history queries — not onCreated history
const recent = await chrome.downloads.search({
  limit: 50,
  orderBy: ['-startTime'],
  state: 'complete',
})
```

## Tabs API

```typescript
// ✅ Track tab events for mode-aware metrics
chrome.tabs.onActivated.addListener(async ({ tabId }) => {
  const tab = await chrome.tabs.get(tabId)
  if (!tab.url || !tab.url.startsWith('http')) return   // skip chrome:// pages

  await queueTabEvent({
    tabId,
    url:   new URL(tab.url).hostname,   // domain only — never full URL with params
    title: tab.title ?? '',
    timestamp: Date.now(),
  })
})

// ✅ Never store full URLs — domain only for privacy
// ✅ Filter out chrome://, extension://, about: pages
```

## API Communication — Fetch with Retry

```typescript
// ✅ All API calls from service worker use fetch — never XMLHttpRequest
// ✅ Implement retry with exponential backoff for network failures
export async function apiRequest<T>(
  endpoint: string,
  options: RequestInit = {},
  retries = 3
): Promise<T> {
  const token = await getStorage('accessToken')

  for (let attempt = 0; attempt < retries; attempt++) {
    try {
      const response = await fetch(`${API_BASE_URL}${endpoint}`, {
        ...options,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`,
          ...options.headers,
        },
      })
      if (!response.ok) throw new Error(`HTTP ${response.status}`)
      return response.json()
    } catch (err) {
      if (attempt === retries - 1) throw err
      await new Promise(r => setTimeout(r, Math.pow(2, attempt) * 1000))
    }
  }
  throw new Error('Max retries exceeded')
}
```

## No Remote Code

```typescript
// ❌ Manifest V3 prohibits all remote code execution
// Never use eval(), new Function(), or remote script tags
// All code must be bundled with the extension package

// ❌ This will fail Chrome Web Store review
fetch('https://cdn.example.com/script.js').then(r => r.text()).then(eval)
```
